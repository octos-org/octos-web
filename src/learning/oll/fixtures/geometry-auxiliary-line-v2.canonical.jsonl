:"board.emphasize","target":{"node_id":"lesson-geometry-v2-001:node:clean-diagram","fragment_id":"lesson-geometry-v2-001:node:clean-diagram:fragment:side-ab"},"emphasis":"resolved"},{"action_id":"lesson-geometry-v2-001:action:3:2:2","op":"board.emphasize","target":{"node_id":"lesson-geometry-v2-001:node:clean-diagram","fragment_id":"lesson-geometry-v2-001:node:clean-diagram:fragment:side-ac"},"emphasis":"resolved"},{"action_id":"lesson-geometry-v2-001:action:3:2:3","op":"board.emphasize","target":{"node_id":"lesson-geometry-v2-001:node:clean-diagram","fragment_id":"lesson-geometry-v2-001:node:clean-diagram:fragment:segment-bd"},"emphasis":"focus"},{"action_id":"lesson-geometry-v2-001:action:3:2:4","op":"board.emphasize","target":{"node_id":"lesson-geometry-v2-001:node:clean-diagram","fragment_id":"lesson-geometry-v2-001:node:clean-diagram:fragment:segment-dc"},"emphasis":"focus"},{"action_id":"lesson-geometry-v2-001:action:3:2:5","op":"board.revise","target":{"node_id":"lesson-geometry-v2-001:node:sss-table"},"revision":{"content":{"title":"③ SSS：逐组找对应边","columns":["△ABD","△ACD","依据"],"rows":[["AB","AC","等腰：AB=AC"],["BD","DC","中点：BD=DC"]]},"reason":"加入中点条件对应的第二组边"}}],"after_speech":[{"action_id":"lesson-geometry-v2-001:action:3:2:6","op":"board.focus","focus":{"targets":["lesson-geometry-v2-001:node:clean-diagram","lesson-geometry-v2-001:node:sss-table"],"intent":"compare_second_side_pair"}}]}},{"id":"lesson-geometry-v2-001:step:collect-sss-evidence:beat:mark-common-side","narration":{"text":"还差第三组。AD 同时属于两个三角形，所以 AD 等于它自己。这叫公共边。现在三组边已经全部找齐。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-geometry-v2-001:action:3:3:1","op":"board.emphasize","target":{"node_id":"lesson-geometry-v2-001:node:clean-diagram","fragment_id":"lesson-geometry-v2-001:node:clean-diagram:fragment:segment-bd"},"emphasis":"resolved"},{"action_id":"lesson-geometry-v2-001:action:3:3:2","op":"board.emphasize","target":{"node_id":"lesson-geometry-v2-001:node: