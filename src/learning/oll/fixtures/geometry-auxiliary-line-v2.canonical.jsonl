{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"lesson-geometry-v2-001","sequence":4,"step":{"id":"lesson-geometry-v2-001:step:derive-conclusions","purpose":"把全等结论分别转化为角平分线和垂线","beats":[{"id":"lesson-geometry-v2-001:step:derive-conclusions:beat:derive-angle-bisector","narration":{"text":"先看顶点 A。全等三角形的对应角相等，所以角 BAD 等于角 CAD。这正说明 AD 平分顶角 A。","delivery":"patient"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-geometry-v2-001:action:4:1:1","op":"board.emphasize","target":{"node_id":"lesson-geometry-v2-001:node:clean-diagram","fragment_id":"lesson-geometry-v2-001:node:clean-diagram:fragment:triangle-abd"},"emphasis":"focus"},{"action_id":"lesson-geometry-v2-001:action:4:1:2","op":"board.emphasize","target":{"node_id":"lesson-geometry-v2-001:node:clean-diagram","fragment_id":"lesson-geometry-v2-001:node:clean-diagram:fragment:triangle-acd"},"emphasis":"focus"},{"action_id":"lesson-geometry-v2-001:action:4:1:3","op":"board.create","node":{"id":"lesson-geometry-v2-001:node:angle-result","kind":"math","role":"conclusion","content":{"fragments":[{"id":"lesson-geometry-v2-001:node:angle-result:fragment:angles","latex":"\\angle BAD=\\angle CAD"},{"id":"lesson-geometry-v2-001:node:angle-result:fragment:meaning","latex":"\\Rightarrow AD\\text{ 平分 }\\angle A"}]},"placement":{"relation":"below","align":"start","gap":"normal","anchor":"lesson-geometry-v2-001:node:congruence-result"}}},{"action_id":"lesson-geometry-v2-001:action:4:1:4","op":"board.connect","connection":{"id":"lesson-geometry-v2-001:connection:sss-to-angle","from":{"node_id":"lesson-geometry-v2-001:node:congruence-result","fragment_id":"lesson-geometry-v2-001:node:congruence-result:fragment:statement"},"to":{"node_id":"lesson-geometry-v2-001:node:angle-result","fragment_id":"lesson-geometry-v2-001:node:angle-result:fragment:angles"},"relation":"implies","label":"对应角相等"}}],"after_speech":[{"action_id":"lesson-geometry-v2-001:action:4:1:5","op":"board.focus","focus":{"targets":["lesson-geometry-v2-001:node:angle-result"],"intent":"derive_angle_bisector"}}]}},{"id":"lesson-geometry-v2-001:step:derive-conclusions:beat:compare-d-angles","narration":{"text":"再看 D 点。角 ADB 与角 ADC 是全等三角形的一组对应角，所以它们相等。我们先只写下这一步。","delivery":"careful"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-geometry-v2-001:action:4:2:1","op":"board.emphasize","target":{"node_id":"lesson-geometry-v2-001:node:clean-diagram","fragment_id":"lesson-geometry-v2-001:node:clean-diagram:fragment:triangle-abd"},"emphasis":"resolved"},{"action_id":"lesson-geometry-v2-001:action:4:2:2","op":"board.emphasize","target":{"node_id":"lesson-geometry-v2-001:node:clean-diagram","fragment_id":"lesson-geometry-v2-001:node:clean-diagram:fragment:triangle-acd"},"emphasis":"resolved"},{"action_id":"lesson-geometry-v2-001:action:4:2:3","op":"board.emphasize","target":{"node_id":"lesson-geometry-v2-001:node:clean-diagram","fragment_id":"lesson-geometry-v2-001:node:clean-diagram:fragment:point-d"},"emphasis":"focus"},{"action_id":"lesson-geometry-v2-001:action:4:2:4","op":"board.create","node":{"id":"lesson-geometry-v2-001:node:perpendicular-derivation","kind":"math","role":"conclusion","content":{"latex":"\\angle ADB=\\angle ADC"},"placement":{"relation":"below","align":"start","gap":"normal","anchor":"lesson-geometry-v2-001:node:angle-result"}}},{"action_id":"lesson-geometry-v2-001:action:4:2:5","op":"board.connect","connection":{"id":"lesson-geometry-v2-001:connection:sss-to-d-angles","from":{"node_id":"lesson-geometry-v2-001:node:congruence-result","fragment_id":"lesson-geometry-v2-001:node:congruence-result:fragment:statement"},"to":{"node_id":"lesson-geometry-v2-001:node:perpendicular-derivation"},"relation":"implies","label":"对应角相等"}}],"after_speech":[{"action_id":"lesson-geometry-v2-001:action:4:2:6","op":"board.focus","focus":{"targets":["lesson-geometry-v2-001:node:perpendicular-derivation"],"intent":"compare_angles_at_d"}}]}},{"id":"lesson-geometry-v2-001:step:derive-conclusions:beat:use-straight-angle","narration":{"text":"接着用直线 BC。因为 B、D、C 在一条直线上，角 ADB 与角 ADC 相加是 180 度。两个角既相等，和又是 180 度，所以它们各是 90 度。","delivery":"careful"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-geometry-v2-001:action:4:3:1","op":"board.emphasize","target":{"node_id":"lesson-geometry-v2-001:node:clean-diagram","fragment_id":"lesson-geometry-v2-001:node:clean-diagram:fragment:point-d"},"emphasis":"focus"},{"action_id":"lesson-geometry-v2-001:action:4:3:2","op":"board.revise","target":{"node_id":"lesson-geometry-v2-001:node:perpendicular-derivation"},"revision":{"content":{"latex":"\\begin{aligned}\\angle ADB&=\\angle ADC\\\\ \\angle ADB+\\angle ADC&=180^\\circ\\\\ \\therefore \\angle ADB=\\angle ADC&=90^\\circ\\end{aligned}"},"reason":"加入平角条件并求出两个直角"}}],"after_speech":[{"action_id":"lesson-geometry-v2-001:action:4:3:3","op":"board.focus","focus":{"targets":["lesson-geometry-v2-001:node:perpendicular-derivation"],"intent":"use_straight_angle"}}]}},{"id":"lesson-geometry-v2-001:step:derive-conclusions:beat:conclude-perpendicular","narration":{"text":"角 ADB 是 AD 与 BC 形成的直角，因此 AD 垂直 BC。现在第二个目标也完成了。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"lesson-geometry-v2-001:action:4:4:1","op":"board.emphasize","target":{"node_id":"lesson-geometry-v2-001:node:clean-diagram","fragment_id":"lesson-geometry-v2-001:node:clean-diagram:fragment:point-d"},"emphasis":"resolved"},{"action_id":"lesson-geometry-v2-001:action:4:4:2","op":"board.revise","target":{"node_id":"lesson-geometry-v2-001:node:perpendicular-derivation"},"revision":{"content":{"latex":"\\angle ADB=\\angle ADC=90^\\circ \\Rightarrow AD\\perp BC"},"reason":"把九十度角翻译成垂直关系"}}],"after_speech":[{"action_id":"lesson-geometry-v2-001:action:4:4:3","op":"board.focus","focus":{"targets":["lesson-geometry-v2-001:node:perpendicular-derivation"],"intent":"conclude_perpendicular"}}]}}]}}
